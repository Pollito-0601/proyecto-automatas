---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Simulador Chomsky - Tipo 0: Máquina de Turing (MT)">
	<div class="simulator-wrapper">
		<!-- Barra superior -->
		<header class="simulator-header">
			<div class="header-left">
				<span class="menu-icon">≡</span>
				<h1>Simulador Chomsky - Tipo 0: Máquina de Turing (MT)</h1>
			</div>
			<div class="header-right">
				<a href="/" class="exit-link" title="Volver al panel principal">
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
						<polyline points="16 17 21 12 16 7"></polyline>
						<line x1="21" y1="12" x2="9" y2="12"></line>
					</svg>
				</a>
			</div>
		</header>

		<!-- Barra superior de Input -->
		<section class="top-input-bar">
			<div class="input-card">
				<span class="input-label">Input</span>
				<div class="input-row">
					<input type="text" id="cadenaInput" placeholder="Ingresa la cadena a evaluar: abbcc" value="abbcc" autocomplete="off" />
					<button id="btnIniciar" class="btn btn-primary">Iniciar</button>
				</div>
				<div class="presets-row">
					<span class="presets-label">Ejemplos:</span>
					<button class="preset-btn" data-val="abc">abc (1*1=1)</button>
					<button class="preset-btn" data-val="abbcc">abbcc (1*2=2)</button>
					<button class="preset-btn" data-val="aabcc">aabcc (2*1=2)</button>
					<button class="preset-btn" data-val="aabbcccc">aabbcccc (2*2=4)</button>
					<button class="preset-btn invalid" data-val="ab">ab (inválida)</button>
					<button class="preset-btn invalid" data-val="abcc">abcc (inválida)</button>
				</div>
			</div>
		</section>

		<!-- Tablero de 3 columnas superiores -->
		<main class="grid-main-compact">
			<!-- Columna 1: Traza y Estado -->
			<section class="card-panel panel-trace">
				<h2 class="panel-title">Traza y estado</h2>
				
				<div class="string-display-container">
					<div id="stringDisplay" class="string-display">
						<span class="placeholder-text font-mono">Esperando cadena...</span>
					</div>
				</div>

				<div class="trace-history-container">
					<ul id="traceList" class="trace-list font-mono">
						<li class="empty-trace">Presiona "Iniciar" para comenzar la simulación.</li>
					</ul>
				</div>

				<div id="statusBadge" class="status-badge idle">
					<span class="status-title">Listo para simular</span>
					<span class="status-subtitle">Ingresa una cadena y presiona Iniciar</span>
				</div>
			</section>

			<!-- Columna 2: Gráfico del Autómata (MT) -->
			<section class="card-panel panel-automaton">
				<h2 class="panel-title">Máquina de Turing Determinista (a^n b^m c^n*m)</h2>
				<div class="svg-canvas-container">
					<svg id="automatonSvg" viewBox="0 0 540 270" class="automaton-svg">
						<defs>
							<marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
								<path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#64748b" />
							</marker>
							<marker id="arrow-active" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
								<path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#38bdf8" />
							</marker>
						</defs>

						<!-- Flecha inicial a q0 -->
						<path d="M 20 60 L 54 60" stroke="#64748b" stroke-width="2.5" marker-end="url(#arrow)" fill="none" />

						<!-- Conexiones superiores -->
						<path d="M 105 60 L 174 60" stroke="#64748b" stroke-width="2" marker-end="url(#arrow)" fill="none" class="trans-edge" id="edge_q0_q1" />
						<text x="140" y="50" fill="#94a3b8" font-size="10" text-anchor="middle" font-family="'JetBrains Mono', monospace">a/X, R</text>

						<!-- Auto-bucle q1 -->
						<path d="M 188 38 C 172 6, 228 6, 212 38" stroke="#64748b" stroke-width="2" marker-end="url(#arrow)" fill="none" class="trans-edge" id="edge_q1_q1" />
						<text x="200" y="6" fill="#94a3b8" font-size="9" text-anchor="middle" font-family="'JetBrains Mono', monospace">a,Y / R</text>

						<path d="M 225 60 L 294 60" stroke="#64748b" stroke-width="2" marker-end="url(#arrow)" fill="none" class="trans-edge" id="edge_q1_q2" />
						<text x="260" y="50" fill="#94a3b8" font-size="10" text-anchor="middle" font-family="'JetBrains Mono', monospace">b/Y, R</text>

						<!-- Auto-bucle q2 -->
						<path d="M 308 38 C 292 6, 348 6, 332 38" stroke="#64748b" stroke-width="2" marker-end="url(#arrow)" fill="none" class="trans-edge" id="edge_q2_q2" />
						<text x="320" y="6" fill="#94a3b8" font-size="9" text-anchor="middle" font-family="'JetBrains Mono', monospace">b,Z / R</text>

						<path d="M 345 60 L 414 60" stroke="#64748b" stroke-width="2" marker-end="url(#arrow)" fill="none" class="trans-edge" id="edge_q2_q3" />
						<text x="380" y="50" fill="#94a3b8" font-size="10" text-anchor="middle" font-family="'JetBrains Mono', monospace">c/Z, L</text>

						<!-- Auto-bucle q3 -->
						<path d="M 428 38 C 412 6, 468 6, 452 38" stroke="#64748b" stroke-width="2" marker-end="url(#arrow)" fill="none" class="trans-edge" id="edge_q3_q3" />
						<text x="440" y="6" fill="#94a3b8" font-size="9" text-anchor="middle" font-family="'JetBrains Mono', monospace">b,Z / L</text>

						<!-- Retorno q3 -> q1 -->
						<path d="M 420 78 Q 320 110 224 74" stroke="#64748b" stroke-width="2" marker-end="url(#arrow)" fill="none" class="trans-edge" id="edge_q3_q1" />
						<text x="320" y="105" fill="#94a3b8" font-size="10" text-anchor="middle" font-family="'JetBrains Mono', monospace">Y/Y, R</text>

						<!-- Restauración q1 -> q4 -->
						<path d="M 200 85 L 200 154" stroke="#64748b" stroke-width="2" marker-end="url(#arrow)" fill="none" class="trans-edge" id="edge_q1_q4" />
						<text x="216" y="125" fill="#94a3b8" font-size="10" text-anchor="start" font-family="'JetBrains Mono', monospace">Z/Z, L</text>

						<!-- Auto-bucle q4 -->
						<path d="M 188 198 C 172 232, 228 232, 212 198" stroke="#64748b" stroke-width="2" marker-end="url(#arrow)" fill="none" class="trans-edge" id="edge_q4_q4" />
						<text x="200" y="244" fill="#94a3b8" font-size="9" text-anchor="middle" font-family="'JetBrains Mono', monospace">a,Y,b / L</text>

						<!-- Retorno q4 -> q0 -->
						<path d="M 175 175 Q 85 175 80 88" stroke="#64748b" stroke-width="2" marker-end="url(#arrow)" fill="none" class="trans-edge" id="edge_q4_q0" />
						<text x="110" y="145" fill="#94a3b8" font-size="10" text-anchor="middle" font-family="'JetBrains Mono', monospace">X/X, R</text>

						<!-- Verificación q0 -> q5 -->
						<path d="M 90 82 Q 110 200 300 200" stroke="#64748b" stroke-width="2" marker-end="url(#arrow)" fill="none" class="trans-edge" id="edge_q0_q5" />
						<text x="180" y="215" fill="#94a3b8" font-size="10" text-anchor="middle" font-family="'JetBrains Mono', monospace">Y/Y, R</text>

						<!-- Auto-bucle q5 -->
						<path d="M 313 223 C 297 257, 353 257, 337 223" stroke="#64748b" stroke-width="2" marker-end="url(#arrow)" fill="none" class="trans-edge" id="edge_q5_q5" />
						<text x="325" y="265" fill="#94a3b8" font-size="9" text-anchor="middle" font-family="'JetBrains Mono', monospace">Y,Z / R</text>

						<!-- Aceptación q5 -> q_accept -->
						<path d="M 350 200 L 414 200" stroke="#64748b" stroke-width="2" marker-end="url(#arrow)" fill="none" class="trans-edge" id="edge_q5_q_accept" />
						<text x="382" y="190" fill="#94a3b8" font-size="10" text-anchor="middle" font-family="'JetBrains Mono', monospace">B/B, S</text>

						<!-- Transiciones deterministas a garbageCollector (q_err) -->
						<path d="M 80 85 L 80 174" stroke="#64748b" stroke-width="1.8" marker-end="url(#arrow)" fill="none" class="trans-edge" id="edge_q0_garbageCollector" />
						<path d="M 182 78 L 98 185" stroke="#64748b" stroke-width="1.8" marker-end="url(#arrow)" fill="none" class="trans-edge" id="edge_q1_garbageCollector" />
						<path d="M 300 210 L 102 200" stroke="#64748b" stroke-width="1.8" marker-end="url(#arrow)" fill="none" class="trans-edge" id="edge_q5_garbageCollector" />
						<path d="M 68 223 C 52 257, 108 257, 92 223" stroke="#64748b" stroke-width="1.8" marker-end="url(#arrow)" fill="none" class="trans-edge" id="edge_garbageCollector_garbageCollector" />
						<text x="80" y="265" fill="#f87171" font-size="9" text-anchor="middle" font-family="'JetBrains Mono', monospace">otro</text>


						<!-- NODOS -->
						<!-- q0 -->
						<g id="node_q0" class="state-group" transform="translate(80, 60)">
							<g class="actual-indicator hidden" id="tag_q0">
								<rect x="-24" y="-48" width="48" height="18" rx="4" fill="#0284c7" />
								<text x="0" y="-35" fill="#ffffff" font-size="10" font-weight="800" text-anchor="middle">Actual</text>
							</g>
							<circle r="25" fill="#1e293b" stroke="#334155" stroke-width="2.5" class="node-circle" />
							<text y="5" fill="#f8fafc" font-size="13" font-weight="700" text-anchor="middle" font-family="'JetBrains Mono', monospace">q0</text>
						</g>

						<!-- q1 -->
						<g id="node_q1" class="state-group" transform="translate(200, 60)">
							<g class="actual-indicator hidden" id="tag_q1">
								<rect x="-24" y="-48" width="48" height="18" rx="4" fill="#0284c7" />
								<text x="0" y="-35" fill="#ffffff" font-size="10" font-weight="800" text-anchor="middle">Actual</text>
							</g>
							<circle r="25" fill="#1e293b" stroke="#334155" stroke-width="2.5" class="node-circle" />
							<text y="5" fill="#f8fafc" font-size="13" font-weight="700" text-anchor="middle" font-family="'JetBrains Mono', monospace">q1</text>
						</g>

						<!-- q2 -->
						<g id="node_q2" class="state-group" transform="translate(320, 60)">
							<g class="actual-indicator hidden" id="tag_q2">
								<rect x="-24" y="-48" width="48" height="18" rx="4" fill="#0284c7" />
								<text x="0" y="-35" fill="#ffffff" font-size="10" font-weight="800" text-anchor="middle">Actual</text>
							</g>
							<circle r="25" fill="#1e293b" stroke="#334155" stroke-width="2.5" class="node-circle" />
							<text y="5" fill="#f8fafc" font-size="13" font-weight="700" text-anchor="middle" font-family="'JetBrains Mono', monospace">q2</text>
						</g>

						<!-- q3 -->
						<g id="node_q3" class="state-group" transform="translate(440, 60)">
							<g class="actual-indicator hidden" id="tag_q3">
								<rect x="-24" y="-48" width="48" height="18" rx="4" fill="#0284c7" />
								<text x="0" y="-35" fill="#ffffff" font-size="10" font-weight="800" text-anchor="middle">Actual</text>
							</g>
							<circle r="25" fill="#1e293b" stroke="#334155" stroke-width="2.5" class="node-circle" />
							<text y="5" fill="#f8fafc" font-size="13" font-weight="700" text-anchor="middle" font-family="'JetBrains Mono', monospace">q3</text>
						</g>

						<!-- q4 -->
						<g id="node_q4" class="state-group" transform="translate(200, 175)">
							<g class="actual-indicator hidden" id="tag_q4">
								<rect x="-24" y="-48" width="48" height="18" rx="4" fill="#0284c7" />
								<text x="0" y="-35" fill="#ffffff" font-size="10" font-weight="800" text-anchor="middle">Actual</text>
							</g>
							<circle r="25" fill="#1e293b" stroke="#334155" stroke-width="2.5" class="node-circle" />
							<text y="5" fill="#f8fafc" font-size="13" font-weight="700" text-anchor="middle" font-family="'JetBrains Mono', monospace">q4</text>
						</g>

						<!-- q5 -->
						<g id="node_q5" class="state-group" transform="translate(325, 200)">
							<g class="actual-indicator hidden" id="tag_q5">
								<rect x="-24" y="-48" width="48" height="18" rx="4" fill="#0284c7" />
								<text x="0" y="-35" fill="#ffffff" font-size="10" font-weight="800" text-anchor="middle">Actual</text>
							</g>
							<circle r="25" fill="#1e293b" stroke="#334155" stroke-width="2.5" class="node-circle" />
							<text y="5" fill="#f8fafc" font-size="13" font-weight="700" text-anchor="middle" font-family="'JetBrains Mono', monospace">q5</text>
						</g>

						<!-- q_accept (DOBLE CÍRCULO FINAL) -->
						<g id="node_q_accept" class="state-group" transform="translate(440, 200)">
							<g class="actual-indicator hidden" id="tag_q_accept">
								<rect x="-24" y="-48" width="48" height="18" rx="4" fill="#10b981" />
								<text x="0" y="-35" fill="#ffffff" font-size="10" font-weight="800" text-anchor="middle">Actual</text>
							</g>
							<circle r="27" fill="#1e293b" stroke="#334155" stroke-width="2.5" class="node-circle-outer" />
							<circle r="21" fill="#1e293b" stroke="#334155" stroke-width="2" class="node-circle" />
							<text y="4" fill="#34d399" font-size="11" font-weight="800" text-anchor="middle" font-family="'JetBrains Mono', monospace">q_acc</text>
						</g>

						<!-- garbageCollector (q_err - ESTADO DE TRAMPA) -->
						<g id="node_garbageCollector" class="state-group" transform="translate(80, 200)">
							<circle r="22" fill="#1e293b" stroke="#ef4444" stroke-width="2" class="node-circle" />
							<text y="4" fill="#f87171" font-size="10" font-weight="700" text-anchor="middle" font-family="'JetBrains Mono', monospace">q_err</text>
						</g>
					</svg>
				</div>
					</section>
			<!-- Columna 3: Barra de Manejo de la Simulación -->
			<section class="card-panel panel-controls-side">
				<h2 class="panel-title">Manejo de simulación</h2>
				
				<div class="control-side-box">
					<div class="control-side-buttons">
						<button id="btnAnterior" class="btn btn-secondary btn-full" title="Paso Anterior">Anterior (◀)</button>
						<button id="btnPausa" class="btn btn-primary btn-full" title="Pausar / Reanudar">Pausar (⏸)</button>
						<button id="btnSiguiente" class="btn btn-secondary btn-full" title="Paso Siguiente">Siguiente (▶)</button>
					</div>

					<div class="speed-control-side">
						<span class="speed-title">Velocidad:</span>
						<div class="speed-btn-group">
							<button class="speed-toggle" data-mult="0.5">x0.5</button>
							<button class="speed-toggle active" data-mult="1">x1</button>
							<button class="speed-toggle" data-mult="2">x2</button>
						</div>
						<span id="speedVal" class="speed-display">1400ms</span>
					</div>

					<div class="side-info-card">
						<span class="side-info-title">Reglas de la MT</span>
						<p class="side-info-text">Multiplica la cantidad de 'a' por 'b' verificando que coincida exactamente con las 'c' sobre la cinta infinita.</p>
					</div>
				</div>
			</section>
		</main>

		<!-- Sección Inferior: Cinta de Turing y Cabezal a Todo lo Ancho -->
		<section class="bottom-tape-section">
			<div class="tape-container-box-wide">
				<div class="tape-header-info">
					<span class="tape-badge">Cinta de Turing [ MT ]</span>
					<span id="headPosInfo" class="head-badge font-mono">Cabezal: Pos 1</span>
				</div>

				<div class="head-indicator-wrapper">
					<div id="headPointer" class="head-pointer">
						<span class="head-label">CABEZAL L/R</span>
						<div class="head-arrow">▼</div>
					</div>
				</div>

				<div class="tape-track-wide-wrapper">
					<div class="tape-track" id="tapeTrack">
						<!-- Celdas renderizadas dinámicamente -->
					</div>
				</div>
			</div>
		</section>

		<!-- Modal de Rechazo -->
		<div id="modalRechazo" class="modal-backdrop hidden">
			<div class="modal-card">
				<div class="modal-icon-badge">✕</div>
				<h3 class="modal-title">Cadena Rechazada</h3>
				<p id="modalMotivo" class="modal-text">La cadena no cumple la relación de multiplicación a^n b^m c^n*m.</p>
				<div id="modalDetalle" class="modal-detail font-mono">Estado final: q_err</div>
				<button id="btnCerrarModal" class="btn btn-primary modal-btn">Entendido / Intentar otra</button>
			</div>
		</div>
	</div>
</Layout>

<style>
	.simulator-wrapper {
		display: flex;
		flex-direction: column;
		height: 100vh;
		background: #0c111d;
		overflow: hidden;
	}

	.simulator-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 12px 24px;
		background: #111827;
		border-bottom: 1px solid #1f293d;
	}

	.header-left {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.menu-icon {
		font-size: 1.4rem;
		color: #94a3b8;
		cursor: pointer;
	}

	.simulator-header h1 {
		font-size: 1.05rem;
		font-weight: 700;
		color: #f1f5f9;
	}

	.exit-link {
		color: #94a3b8;
		display: flex;
		align-items: center;
		padding: 6px;
		border-radius: 6px;
		transition: all 0.2s;
	}
	.exit-link:hover {
		color: #38bdf8;
		background: #1e293b;
	}

	/* Barra superior de Input */
	.top-input-bar {
		padding: 10px 24px;
		background: #0f172a;
		border-bottom: 1px solid #1e293b;
	}

	.input-card {
		background: #151c2e;
		border: 1px solid #273452;
		border-radius: 12px;
		padding: 8px 16px 10px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.input-label {
		font-size: 0.72rem;
		color: #818cf8;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.input-row {
		display: flex;
		gap: 10px;
	}

	.input-row input {
		flex: 1;
		background: transparent;
		border: none;
		outline: none;
		color: #f8fafc;
		font-family: 'JetBrains Mono', monospace;
		font-size: 1rem;
	}

	.presets-row {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}

	.presets-label {
		font-size: 0.72rem;
		color: #64748b;
	}

	.preset-btn {
		background: #1e293b;
		border: 1px solid #334155;
		color: #94a3b8;
		font-size: 0.72rem;
		padding: 2px 8px;
		border-radius: 4px;
		cursor: pointer;
		font-family: 'JetBrains Mono', monospace;
		transition: all 0.15s;
	}
	.preset-btn:hover {
		color: #38bdf8;
		border-color: #38bdf8;
	}
	.preset-btn.invalid:hover {
		color: #f87171;
		border-color: #ef4444;
	}

	/* Tablero Compacto Superior */
	.grid-main-compact {
		display: grid;
		grid-template-columns: 290px 1fr 240px;
		gap: 14px;
		padding: 12px 24px 6px;
		flex: 1;
		min-height: 0;
		overflow: hidden;
	}

	.card-panel {
		background: #151c2e;
		border: 1px solid #273452;
		border-radius: 14px;
		padding: 14px;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.panel-title {
		font-size: 0.92rem;
		font-weight: 700;
		color: #f1f5f9;
		margin-bottom: 10px;
	}

	/* Traza y Estado */
	.string-display-container {
		background: #0d1322;
		border: 1px solid #1e293b;
		border-radius: 8px;
		padding: 10px 8px 18px;
		margin-bottom: 10px;
		text-align: center;
	}

	.string-display {
		font-size: 1.25rem;
		letter-spacing: 0.25em;
		display: flex;
		justify-content: center;
		align-items: center;
		min-height: 32px;
	}

	:global(.char-box) {
		position: relative;
		display: inline-block;
		padding: 0 4px;
		color: #f8fafc;
		font-weight: 700;
		transition: all 0.2s;
	}

	:global(.char-box.active) {
		color: #38bdf8;
		background: rgba(56, 189, 248, 0.2);
		border-radius: 6px;
	}

	.trace-history-container {
		flex: 1;
		background: #0d1322;
		border: 1px solid #1e293b;
		border-radius: 8px;
		padding: 10px;
		overflow-y: auto;
		margin-bottom: 10px;
	}

	.trace-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 5px;
	}

	:global(.trace-item) {
		font-size: 0.75rem;
		color: #94a3b8;
		padding: 5px 7px;
		border-radius: 5px;
		background: rgba(30, 41, 59, 0.4);
		border-left: 3px solid transparent;
		transition: all 0.2s;
	}

	:global(.trace-item.active-step) {
		color: #f8fafc;
		background: rgba(56, 189, 248, 0.12);
		border-left: 3px solid #38bdf8;
	}

	.status-badge {
		border-radius: 8px;
		padding: 10px 12px;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.status-badge.idle {
