	/* Sección Inferior: Cinta de Turing a Todo lo Ancho */
	.bottom-tape-section {
		padding: 6px 24px 14px;
	}

	.tape-container-box-wide {
		background: #151c2e;
		border: 1px solid #273452;
		border-radius: 12px;
		padding: 12px 18px;
	}

	.tape-header-info {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 8px;
	}

	.tape-badge {
		font-size: 0.72rem;
		background: rgba(239, 68, 68, 0.15);
		color: #f87171;
		padding: 4px 8px;
		border-radius: 6px;
		font-weight: 700;
	}

	.head-badge {
		font-size: 0.75rem;
		color: #38bdf8;
		background: #1e293b;
		padding: 4px 8px;
		border-radius: 6px;
	}

	.head-indicator-wrapper {
		position: relative;
		height: 32px;
		margin-bottom: 4px;
	}

	.head-pointer {
		position: absolute;
		left: 0;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		transition: left 0.25s ease;
	}

	.head-label {
		font-size: 0.62rem;
		font-weight: 800;
		color: #38bdf8;
		background: #0369a1;
		padding: 2px 6px;
		border-radius: 4px;
		letter-spacing: 0.05em;
	}

	.head-arrow {
		color: #38bdf8;
		font-size: 0.9rem;
		margin-top: -2px;
	}

	.tape-track-wide-wrapper {
		width: 100%;
		overflow-x: auto;
		background: #0d1322;
		border: 1.5px solid #334155;
		border-radius: 8px;
		padding: 10px 14px;
	}

	.tape-track {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-width: 100%;
		justify-content: center;
	}

	:global(.tape-cell) {
		min-width: 40px;
		height: 44px;
		background: #1e293b;
		border: 1.5px solid #475569;
		border-radius: 6px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: 'JetBrains Mono', monospace;
		font-size: 1.15rem;
		font-weight: 800;
		color: #f8fafc;
		transition: all 0.2s;
	}

	:global(.tape-cell.blank) {
		color: #64748b;
		border-style: dashed;
		border-color: #334155;
	}

	:global(.tape-cell.active-head) {
		border-color: #38bdf8;
		background: #1e3a5f;
		color: #38bdf8;
		box-shadow: 0 0 14px rgba(56, 189, 248, 0.7);
	}

	/* Modal de Rechazo */
	.modal-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(2, 6, 23, 0.78);
		backdrop-filter: blur(4px);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 100;
		transition: opacity 0.2s ease;
	}
	.modal-backdrop.hidden {
		display: none;
	}

	.modal-card {
		background: #171d2e;
		border: 1.5px solid #ef4444;
		border-radius: 16px;
		padding: 28px 32px;
		max-width: 440px;
		width: 90%;
		text-align: center;
		box-shadow: 0 0 40px rgba(239, 68, 68, 0.4);
		animation: popIn 0.25s ease-out;
	}

	@keyframes popIn {
		from { transform: scale(0.92); opacity: 0; }
		to { transform: scale(1); opacity: 1; }
	}

	.modal-icon-badge {
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: rgba(239, 68, 68, 0.2);
		color: #ef4444;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.6rem;
		font-weight: 800;
		margin: 0 auto 16px;
		box-shadow: 0 0 20px rgba(239, 68, 68, 0.3);
	}

	.modal-title {
		font-size: 1.3rem;
		color: #f87171;
		font-weight: 800;
		margin-bottom: 8px;
	}

	.modal-text {
		font-size: 0.92rem;
		color: #cbd5e1;
		margin-bottom: 14px;
		line-height: 1.5;
	}

	.modal-detail {
		background: #0d1322;
		border: 1px solid #334155;
		padding: 8px 12px;
		border-radius: 6px;
		color: #94a3b8;
		font-size: 0.8rem;
		margin-bottom: 20px;
	}

	.modal-btn {
		width: 100%;
		background: #dc2626;
		border-color: #ef4444;
	}
	.modal-btn:hover {
		background: #b91c1c;
	}
</style>

<script>
	let steps: any[] = [];
	let currentStepIdx = 0;
	let timer: any = null;
	let isPaused = false;
	const BASE_SPEED = 1400;
	let speedMs = 1400;

	const cadenaInput = document.getElementById('cadenaInput') as HTMLInputElement;
	const btnIniciar = document.getElementById('btnIniciar');
	const btnAnterior = document.getElementById('btnAnterior') as HTMLButtonElement;
	const btnPausa = document.getElementById('btnPausa') as HTMLButtonElement;
	const btnSiguiente = document.getElementById('btnSiguiente') as HTMLButtonElement;
	const speedVal = document.getElementById('speedVal');

	const stringDisplay = document.getElementById('stringDisplay');
	const traceList = document.getElementById('traceList');
	const statusBadge = document.getElementById('statusBadge');
	const tapeTrack = document.getElementById('tapeTrack');
	const headPointer = document.getElementById('headPointer');
	const headPosInfo = document.getElementById('headPosInfo');

	const modalRechazo = document.getElementById('modalRechazo');
	const modalMotivo = document.getElementById('modalMotivo');
	const modalDetalle = document.getElementById('modalDetalle');
	const btnCerrarModal = document.getElementById('btnCerrarModal');

	// Presets
	document.querySelectorAll('.preset-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			const val = btn.getAttribute('data-val') || '';
			cadenaInput.value = val;
			iniciarSimulacion();
		});
	});

	// Velocidad: solo x0.5, x1, x2
	document.querySelectorAll('.speed-toggle').forEach(btn => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.speed-toggle').forEach(b => b.classList.remove('active'));
			btn.classList.add('active');
			const mult = parseFloat(btn.getAttribute('data-mult') || '1');
			speedMs = Math.round(BASE_SPEED / mult);
			if (speedVal) speedVal.textContent = `${speedMs}ms`;

			if (timer && !isPaused) {
				clearInterval(timer);
				timer = setInterval(avanzarPasoAutomatico, speedMs);
			}
		});
	});

	btnIniciar?.addEventListener('click', iniciarSimulacion);
	btnAnterior?.addEventListener('click', () => { pausar(); retrocederPaso(); });
	btnSiguiente?.addEventListener('click', () => { pausar(); avanzarPaso(); });
	btnPausa?.addEventListener('click', togglePausa);
	btnCerrarModal?.addEventListener('click', () => modalRechazo?.classList.add('hidden'));

	async function iniciarSimulacion() {
		const inputVal = cadenaInput.value.trim();
		limpiarEstado();

		try {
			const res = await fetch('http://localhost:8080/api/v1/simulador/nivel-0', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ input: inputVal })
			});

			if (!res.ok) throw new Error('Error al conectar con el backend');
			const data = await res.json();
			steps = data.steps || [];
			currentStepIdx = 0;

			renderCadena(inputVal);
			renderListaTraza(steps);
			actualizarPaso(0);

			if (steps.length > 1) {
				iniciarReproduccion();
			} else {
				evaluarFinSimulacion(data);
			}
		} catch (err: any) {
			console.error(err);
			alert('No se pudo conectar con el backend en http://localhost:8080. Verifica que Spring Boot esté corriendo.');
		}
	}

	function limpiarEstado() {
		if (timer) clearInterval(timer);
		timer = null;
		isPaused = false;
		if (btnPausa) btnPausa.textContent = 'Pausar (⏸)';
		modalRechazo?.classList.add('hidden');
		setStatus('running', 'Evaluando...', 'Cadena en proceso de aceptación');
	}

	function renderCadena(cadena: string) {
		if (!stringDisplay) return;
		if (!cadena) {
			stringDisplay.innerHTML = '<span class="char-box">ε (cadena vacía)</span>';
			return;
		}
		stringDisplay.innerHTML = cadena.split('').map((c, idx) => `<span class="char-box" id="char_${idx}">${c}</span>`).join('');
	}

	function renderListaTraza(pasos: any[]) {
		if (!traceList) return;
		traceList.innerHTML = pasos.map((p, idx) => `
			<li class="trace-item" id="trace_${idx}">
				${p.description}
			</li>
		`).join('');
	}

	function renderCinta(celdas: string[], cabezalPos: number) {
		if (!tapeTrack) return;
		if (!celdas || celdas.length === 0) return;

		tapeTrack.innerHTML = celdas.map((simbolo, idx) => {
			const isBlank = simbolo === 'B';
			const isActive = idx === cabezalPos;
			return `<div class="tape-cell ${isBlank ? 'blank' : ''} ${isActive ? 'active-head' : ''}" id="cell_${idx}">${simbolo}</div>`;
		}).join('');

		const activeCell = document.getElementById(`cell_${cabezalPos}`);
		if (activeCell && headPointer) {
			const cellRect = activeCell.getBoundingClientRect();
			const trackWrapper = tapeTrack.parentElement;
			if (trackWrapper) {
				const trackRect = trackWrapper.getBoundingClientRect();
				const offsetLeft = (cellRect.left - trackRect.left) + (cellRect.width / 2);
				headPointer.style.left = `${offsetLeft}px`;
			}
		}

		if (headPosInfo) {
			headPosInfo.textContent = `Cabezal: Pos ${cabezalPos} (${celdas[cabezalPos] || 'B'})`;
		}
	}

	function actualizarPaso(idx: number) {
		if (idx < 0 || idx >= steps.length) return;
		currentStepIdx = idx;
		const step = steps[idx];

		// Resaltar ítem de traza
		document.querySelectorAll('.trace-item').forEach(el => el.classList.remove('active-step'));
		const activeTrace = document.getElementById(`trace_${idx}`);
		if (activeTrace) {
			activeTrace.classList.add('active-step');
			activeTrace.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
		}

		// Resaltar nodo en el SVG y tags de "Actual"
		document.querySelectorAll('.state-group').forEach(el => el.classList.remove('active-state'));
		document.querySelectorAll('.actual-indicator').forEach(el => el.classList.add('hidden'));

		const targetStateNode = document.getElementById(`node_${step.nextState}`);
		if (targetStateNode) {
			targetStateNode.classList.add('active-state');
			const tag = document.getElementById(`tag_${step.nextState}`);
			if (tag) tag.classList.remove('hidden');
		}

		// Resaltar flecha
		document.querySelectorAll('.trans-edge').forEach(el => el.classList.remove('active-edge'));
		if (step.currentState && step.nextState) {
			const edge = document.getElementById(`edge_${step.currentState}_${step.nextState}`);
			if (edge) edge.classList.add('active-edge');
		}

		// Actualizar cinta de Turing
		renderCinta(step.memory, step.stringIndex);
	}

	function avanzarPaso() {
		if (currentStepIdx < steps.length - 1) {
			actualizarPaso(currentStepIdx + 1);
			if (currentStepIdx === steps.length - 1) {
				finalizarSimulacion();
			}
		}
	}

	function retrocederPaso() {
		if (currentStepIdx > 0) {
			actualizarPaso(currentStepIdx - 1);
		}
	}

	function avanzarPasoAutomatico() {
		if (currentStepIdx < steps.length - 1) {
			avanzarPaso();
		} else {
			if (timer) clearInterval(timer);
			timer = null;
			finalizarSimulacion();
		}
	}

	function iniciarReproduccion() {
		if (timer) clearInterval(timer);
		timer = setInterval(avanzarPasoAutomatico, speedMs);
	}

	function togglePausa() {
		if (isPaused) {
			isPaused = false;
			if (btnPausa) btnPausa.textContent = 'Pausar (⏸)';
			iniciarReproduccion();
		} else {
			pausar();
		}
	}

	function pausar() {
		isPaused = true;
		if (timer) clearInterval(timer);
		timer = null;
		if (btnPausa) btnPausa.textContent = 'Reanudar (▶)';
	}

	function finalizarSimulacion() {
		if (timer) clearInterval(timer);
		timer = null;
		const finalStep = steps[steps.length - 1];
		evaluarFinSimulacion(finalStep);
	}

	function evaluarFinSimulacion(resultado: any) {
		const lastStep = steps[steps.length - 1];
		const esAceptada = lastStep ? (lastStep.nextState === 'q_accept' && cadenaInput.value.length > 0) : false;

		if (esAceptada) {
			setStatus('accepted', '¡CADENA ACEPTADA!', `Cumple con L = { a^n b^m c^(n*m) | n, m >= 1 }`);
		} else {
			setStatus('rejected', 'CADENA RECHAZADA', `Finalizó en estado: ${lastStep ? lastStep.nextState : 'desconocido'}`);
			mostrarModalRechazo(lastStep);
		}
	}

	function setStatus(tipo: string, titulo: string, subtitulo: string) {
		if (!statusBadge) return;
		statusBadge.className = `status-badge ${tipo}`;
		statusBadge.innerHTML = `
			<span class="status-title">${titulo}</span>
			<span class="status-subtitle">${subtitulo}</span>
		`;
	}

	function mostrarModalRechazo(step: any) {
		if (!modalRechazo || !modalMotivo || !modalDetalle) return;
		const inputStr = cadenaInput.value;
		let motivo = `La cadena "${inputStr}" no satisface la relación de producto a^n b^m c^(n*m).`;
		
		if (!inputStr) {
			motivo = "La cadena está vacía (se requiere a^n b^m c^(n*m) con n, m >= 1).";
		} else if (step && step.nextState === 'garbageCollector') {
			motivo = `Error durante el procesamiento en la Máquina de Turing: ${step.description}`;
		} else if (step && step.nextState !== 'q_accept') {
			motivo = `La máquina se detuvo en el estado "${step.nextState}" sin haber aceptado la cadena.`;
		}

		modalMotivo.textContent = motivo;
		modalDetalle.textContent = `Estado final: ${step ? step.nextState : 'q_err'} | Pasos ejecutados: ${steps.length}`;
		modalRechazo.classList.remove('hidden');
	}
</script>
